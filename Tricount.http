@Tricount_HostAddress = http://localhost:5189

### Get All Tricounts
GET {{Tricount_HostAddress}}/api/tricounts
Accept: application/json

###

### Get Tricount by ID
GET {{Tricount_HostAddress}}/api/tricounts/1
Accept: application/json

###

### Create Tricount
POST {{Tricount_HostAddress}}/api/tricounts
Content-Type: application/json

{
  "name": "Trip to Spain",
  "currency": "EUR",
  "createdByUserId": 1,
  "participants": [
    { "userId": 1 },
    { "userId": 2 },
    { "userId": 3 }
  ]
}

###

### Update Tricount by Route ID
PUT {{Tricount_HostAddress}}/api/tricounts/1
Content-Type: application/json

{
  "id": 1,
  "name": "Summer Trip to Paris",
  "currency": "EUR",
  "createdByUserId": 2,
  "createdAt": "2026-10-01T10:00:00Z",
  "participants": [
    {
      "id": 1,
      "userId": 2
    },
    {
      "id": 2,
      "userId": 3
    },
    {
      "userId": 1
    }
  ]
}

###

### Get All Expenses
GET {{Tricount_HostAddress}}/api/expenses
Accept: application/json

###

### Get Expense by ID
GET {{Tricount_HostAddress}}/api/expenses/1
Accept: application/json

###

### Get Expenses by Group ID
GET {{Tricount_HostAddress}}/api/expenses/group/1
Accept: application/json

###

### Create Expense with Participants (Auto-split: e.g. 100 divided by 2 participants = 50 each)
POST {{Tricount_HostAddress}}/api/expenses
Content-Type: application/json

{
  "groupId": 1,
  "title": "Dinner at Bistro",
  "amount": 100.00,
  "category": "Food & Drinks",
  "paidByUserId": 1,
  "participants": [1, 2]
}

###

### Update Expense by Route ID (Recalculates equal split among participants)
PUT {{Tricount_HostAddress}}/api/expenses/1
Content-Type: application/json

{
  "id": 1,
  "groupId": 1,
  "title": "Luxury Hotel Suite",
  "amount": 100.00,
  "category": "Accommodation",
  "paidByUserId": 2,
  "createdAt": "2026-10-02T12:00:00Z",
  "participants": [1, 2]
}

###

### Delete Expense
DELETE {{Tricount_HostAddress}}/api/expenses/1

